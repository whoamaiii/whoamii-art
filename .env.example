NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
RESEND_API_KEY=re_replace_with_your_resend_key
RESEND_TO_EMAIL=studio@example.com
RESEND_FROM_EMAIL=Studio Name <no-reply@example.com>

# Optional API hardening overrides
SUBMISSION_MAX_BODY_BYTES=12000
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
SUBMISSION_RATE_LIMIT_MAX=8

# Optional distributed rate-limit backend (falls back to in-memory when unset/unavailable)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional salt for fallback rate-limit identity hashing when IP headers are unavailable
RATE_LIMIT_IDENTITY_SALT=
