# Public site URL for canonical metadata and sitemap
NEXT_PUBLIC_SITE_URL=https://whoamiii.art

# Sanity (content source)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# Optional, surfaced in footer fallback
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Resend delivery for inquiry form
RESEND_API_KEY=re_replace_with_your_resend_key
RESEND_TO_EMAIL=studio@example.com
RESEND_FROM_EMAIL=WHOAMIII <no-reply@example.com>

# Inquiry API hardening
INQUIRY_MAX_BODY_BYTES=12000
INQUIRY_RATE_LIMIT_WINDOW_MS=60000
INQUIRY_RATE_LIMIT_MAX=8

# Optional distributed rate-limit backend (falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_IDENTITY_SALT=

# Revalidation webhook secret for Sanity publish hooks
REVALIDATE_SECRET=
